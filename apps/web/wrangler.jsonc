{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "longshelf",
	"compatibility_date": "2026-11-14",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Spec 002 (research R3): Workers AI runs in the owner's account; D1 keeps AI results.
	"ai": { "binding": "AI", "remote": true },
	// Spec 003 (DR-0010): D1 holds mirror metadata; R2 holds files, covers, thumbnails and
	// catalogues keyed by SHA-256; IMAGES makes cover thumbnails at upload (research R4).
	// The all-zero database_id is the local placeholder. Before the first deploy, replace it
	// with the id printed by `wrangler d1 create longshelf` (docs/DEPLOY.md).
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "longshelf" }],
	"images": { "binding": "IMAGES" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "longshelf",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
