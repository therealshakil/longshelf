{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "longshelf",
	"compatibility_date": "2026-11-14",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// One way in: the owner's custom domain, behind Cloudflare Access (spec 003 research R5).
	// workers.dev and preview URLs are off so nothing bypasses it. Change the domain for your
	// own deployment (docs/DEPLOY.md).
	"routes": [{ "pattern": "library.longshelf.app", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": false,
	// Spec 002 (research R3): Workers AI runs in the owner's account; D1 keeps AI results.
	"ai": { "binding": "AI", "remote": true },
	// Spec 003 (DR-0010): D1 holds mirror metadata; R2 holds files, covers, thumbnails and
	// catalogues keyed by SHA-256; IMAGES makes cover thumbnails at upload (research R4).
	"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "longshelf" }],
	"images": { "binding": "IMAGES" },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "longshelf",
			"database_id": "eca9151d-869c-43aa-869e-9fbf5c09bd50",
			"migrations_dir": "migrations"
		}
	]
}
