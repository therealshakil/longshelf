{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "node scripts/gen-tokens.ts && vite dev",
		"build": "node scripts/gen-tokens.ts && wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "node scripts/gen-tokens.ts && vitest --run",
		"test:e2e": "playwright test",
		"gen": "wrangler types",
		"typecheck": "node scripts/gen-tokens.ts && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"gen:tokens": "node scripts/gen-tokens.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.72.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"@ribbon/shared": "workspace:*",
		"cn": "^0.5.2"
	}
}
